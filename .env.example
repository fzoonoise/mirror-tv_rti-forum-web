# RTI Forum — copy to .env and fill in actual values
# Validated in config/environment-variables.ts

# ---- Server-side only (no NEXT_PUBLIC_ prefix) ----

# Backend GraphQL endpoint (used by Proxy API Route and Server Actions)
GRAPHQL_ENDPOINT=https://your-cms-host/api/graphql

# ---- Client-side (NEXT_PUBLIC_ prefix, exposed to browser) ----

# App environment
NEXT_PUBLIC_ENV=dev

# Firebase Authentication (Firebase Console > Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# i18n — supported: zh-TW, en, id, vi, th
NEXT_PUBLIC_DEFAULT_LOCALE=zh-TW
