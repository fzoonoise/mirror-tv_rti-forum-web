# ====================================
# RTI Forum Environment Variables
# ====================================
# Copy this file to `.env` and fill in the actual values
# These variables are validated using Zod in lib/env.ts
#
# SECURITY NOTE:
# All variables below use NEXT_PUBLIC_ prefix, which means they will be
# exposed to the browser. This is intentional and safe for these specific
# variables. Never add actual secrets (database URLs, private API keys) here.

# ====================================
# GraphQL API
# ====================================
# The backend GraphQL endpoint URL
# Default: http://localhost:3000/api/graphql (for local development)
# Production: Replace with your actual backend API URL
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:3000/api/graphql

# ====================================
# Firebase Authentication
# ====================================
# Get these values from Firebase Console:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
#
# IMPORTANT: Firebase API keys are safe to expose publicly
# Security is controlled by Firebase Security Rules, not by hiding these values
# See: https://firebase.google.com/docs/projects/api-keys

# Firebase API Key (find in Firebase Console > Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=

# Firebase Auth Domain (usually YOUR_PROJECT_ID.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Storage Bucket (usually YOUR_PROJECT_ID.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase App ID
NEXT_PUBLIC_FIREBASE_APP_ID=

# ====================================
# Internationalization (i18n)
# ====================================
# Default locale for the application
# Supported values: zh-TW, en, id, vi, th
# Default: zh-TW (Traditional Chinese)
NEXT_PUBLIC_DEFAULT_LOCALE=zh-TW

# ====================================
# Development Notes
# ====================================
# 1. Create a `.env` file by copying this `.env.example`
# 2. Fill in the actual values (DO NOT commit `.env` to git)
# 3. Firebase values are optional for initial setup, but required for auth to work
# 4. GraphQL endpoint will use the default if not specified
# 5. All variables are validated at build time using Zod (see lib/env.ts)
